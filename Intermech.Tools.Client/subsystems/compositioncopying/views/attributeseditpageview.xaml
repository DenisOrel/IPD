<UserControl x:Class="Intermech.Tools.Client.CompositionCopying.Views.AttributesEditPageView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Intermech.Tools.Client.CompositionCopying.Views"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:bcl="http://schemas.intermech.org/bcl/wpf">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <bcl:SharedResourceDictionary CachedSource="CompositionCopyingCommonResources.xaml" InDesignMode="{bcl:InDesignMode}"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4,0,8" TextWrapping="Wrap">
      Измените атрибуты копируемых объектов IPS. Значения, отмеченные желтым цветом, обязательно должны быть изменены и уникальны. Для проверки используйте кнопку "Проверить корректность"
    </TextBlock>
    <DockPanel Grid.Row="1" Grid.Column="0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition MinWidth="350" Width="1*"/>
          <ColumnDefinition Width="5"/>
          <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Column="0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <GroupBox Grid.Row="0" Header="Атрибут">
              <RadComboBox FrameworkElement.Margin="3,5,0,0" FrameworkElement.HorizontalAlignment="Stretch"
                           FrameworkElement.VerticalAlignment="Top" ItemsControl.DisplayMemberPath="Name"
                           telerik:StyleManager.Theme="VisualStudio2013"
                           ItemsControl.ItemsSource="{Binding DataProvider.EditableColumns}"
                           Selector.SelectedIndex="{Binding AttributeNameSelectedIndex, Mode=TwoWay}"/>
            </GroupBox>
            <GroupBox Grid.Row="1" Header="Найти в значении атрибута">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBox HorizontalAlignment="Stretch" Height="25" Margin="3,5,0,0" TextWrapping="Wrap"
                         VerticalAlignment="Top" Grid.Row="0" Grid.Column="0" VerticalContentAlignment="Center"
                         Text="{Binding FindedAttributeValue, Mode=TwoWay}"/>
                <telerik:RadDropDownButton Content="Спецсимвол" Margin="3,5,0,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                           Grid.Row="0" Grid.Column="1" telerik:StyleManager.Theme="Office2013" Background="LightGray">
                  <telerik:RadDropDownButton.DropDownContent>
                    <telerik:RadContextMenu telerik:StyleManager.Theme="Office2013">
                      <telerik:RadMenuItem Header="Произвольное количество символов *" CommandParameter="*"
                                           Command="{Binding SymbolSelectCommand}"/>
                      <telerik:RadMenuItem Header="Любой знак ?" CommandParameter="?" Command="{Binding SymbolSelectCommand}"/>
                      <telerik:RadMenuItem Header="Любая цифра #" CommandParameter="#" Command="{Binding SymbolSelectCommand}"/>
                      <telerik:RadMenuItem Header="Любая буква $" CommandParameter="$" Command="{Binding SymbolSelectCommand}"/>
                    </telerik:RadContextMenu>
                  </telerik:RadDropDownButton.DropDownContent>
                </telerik:RadDropDownButton>
                <CheckBox Content="Учитывать регистр" Margin="3,5,0,0" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                          VerticalContentAlignment="Center" IsChecked="{Binding CaseSensitive, Mode=OneWayToSource}"/>
                <CheckBox Content="Учитывать сходство букв кириллицы и латиницы" Margin="3,5,0,0" Grid.Row="2"
                          Grid.Column="0" Grid.ColumnSpan="2" VerticalContentAlignment="Center"
                          IsChecked="{Binding IsCyrillicSimilarity, Mode=OneWayToSource}"/>
              </Grid>
            </GroupBox>
            <GroupBox Grid.Row="2" Header="Заменить на">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition/>
                </Grid.RowDefinitions>
                <RadioButton Name="TextValueRB" Margin="3,5,0,0" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                             Content="Текст" VerticalContentAlignment="Center"
                             IsChecked="{Binding TextReplaceSelected, Mode=OneWayToSource, FallbackValue=true}"/>
                <TextBox HorizontalAlignment="Stretch" Margin="3,5,0,0" Height="25" TextWrapping="Wrap"
                         VerticalAlignment="Top" Grid.Row="1" Grid.Column="0" VerticalContentAlignment="Center"
                         Text="{Binding ReplaceAttributeValue, Mode=TwoWay}"
                         IsEnabled="{Binding ElementName=TextValueRB, Path=IsChecked}"/>
                <telerik:RadDropDownButton Content="Спецсимвол" Margin="3,5,0,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                           Grid.Row="1" Grid.Column="1" telerik:StyleManager.Theme="Office2013" Background="LightGray"
                                           IsEnabled="{Binding ElementName=TextValueRB, Path=IsChecked}">
                  <telerik:RadDropDownButton.DropDownContent>
                    <telerik:RadContextMenu telerik:StyleManager.Theme="Office2013">
                      <telerik:RadMenuItem Header="Текущее значение атрибута [N]" CommandParameter="[N]"
                                           Command="{Binding SymbolCounterSelectCommand}"/>
                      <telerik:RadMenuItem Header="Счётчик [9999:0:1:1]" CommandParameter="[9999:0:1:1]"
                                           Command="{Binding SymbolCounterSelectCommand}"/>
                    </telerik:RadContextMenu>
                  </telerik:RadDropDownButton.DropDownContent>
                </telerik:RadDropDownButton>
                <RadioButton Name="AttributeValueRB" Margin="3,5,0,0" Grid.Row="2" Content="Значение атрибута" Grid.Column="0"
                             Grid.ColumnSpan="2" VerticalContentAlignment="Center"/>
                <RadComboBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" FrameworkElement.Margin="3,5,0,0"
                             ItemsControl.DisplayMemberPath="Name" telerik:StyleManager.Theme="VisualStudio2013"
                             UIElement.IsEnabled="{Binding ElementName=AttributeValueRB, Path=IsChecked}"
                             ItemsControl.ItemsSource="{Binding DataProvider.EditableColumns}"
                             Selector.SelectedIndex="{Binding AttributeValueNameSelectedIndex, Mode=TwoWay}"/>
                <Grid Row="4" Column="0" ColumnSpan="2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Label Margin="3,5,0,0" Content="Регистр" Grid.Column="0" VerticalAlignment="Top"
                         HorizontalAlignment="Left"/>
                  <RadComboBox Grid.Column="1" FrameworkElement.Margin="3,5,0,0" FrameworkElement.HorizontalAlignment="Stretch"
                               FrameworkElement.VerticalAlignment="Top" ItemsControl.DisplayMemberPath="DisplayName"
                               Selector.SelectedValuePath="Value" telerik:StyleManager.Theme="VisualStudio2013"
                               Selector.SelectedValue="{Binding SelectedRegisterName, Mode=TwoWay}"
                               ItemsControl.ItemsSource="{Binding RegisterNamesList}"/>
                </Grid>
              </Grid>
            </GroupBox>
            <Grid Name="ButtonsGrid" Row="3" HorizontalAlignment="Right">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0" Content="Найти далее" Command="{Binding FindCommand}"/>
              <Button Grid.Column="1" Content="Заменить" Command="{Binding ReplaceCommand}"
                      IsEnabled="{Binding IsEnableReplace, Mode=TwoWay}"/>
              <Button Grid.Column="2" Content="Заменить все" Command="{Binding ReplaceAllCommand}"/>
            </Grid>
          </Grid>
        </ScrollViewer>
        <GridSplitter Grid.Column="1" ShowsPreview="false" Width="5" HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"/>
        <DockPanel Grid.Column="2">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <telerik:RadVirtualGrid Name="VirtualGrid" VerticalAlignment="Top" telerik:StyleManager.Theme="Office2016"
                                    CanUserInsertRows="false" CanUserEdit="true" InitialRowCount="10" InitialColumnCount="10"
                                    MeasureTextOnRender="true" LinesVisibility="Both" CanUserSortColumns="false"
                                    CanUserFilterColumns="false" CanUserResizeColumns="false" CanUserResizeRows="false"
                                    RowHeaderWidth="0" ColumnWidth="150" SelectionMode="Single" CanUserSelect="true"
                                    ShowCellToolTip="true" Grid.Row="0" HorizontalAlignment="Left"
                                    DataProvider="{Binding DataProvider}"
                                    SelectedIndex="{Binding VirtualGridSelectedIndex, Mode=OneWayToSource}"
                                    SelectionBrush="{Binding SelectionBrush}">
              <FrameworkElement.ContextMenu>
                <ContextMenu ItemsSource="{Binding ContextMenuModel.Items}"/>
              </FrameworkElement.ContextMenu>
              <telerik:EventToCommandBehavior.EventBindings>
                <telerik:EventBinding PassEventArgsToCommand="true" EventName="OverlayBrushesNeeded"
                                      Command="{Binding VirtualGridOverlayBrushesNeeded}"/>
                <telerik:EventBinding PassEventArgsToCommand="true" EventName="CellDecorationsNeeded"
                                      Command="{Binding VirtualGridCellDecorationsNeeded}"/>
                <telerik:EventBinding PassEventArgsToCommand="true" EventName="Loaded" Command="{Binding VirtualGridLoaded}"/>
                <telerik:EventBinding PassEventArgsToCommand="true" EventName="SelectionChanged"
                                      Command="{Binding VirtualGridSelectionChanged}"/>
                <telerik:EventBinding PassEventArgsToCommand="true" EventName="HeaderSizeNeeded"
                                      Command="{Binding VirtualGridHeaderSizeNeeded}"/>
              </telerik:EventToCommandBehavior.EventBindings>
            </telerik:RadVirtualGrid>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" HorizontalAlignment="Right" Grid.Row="1">
              <Button Content="Проверить корректность" HorizontalAlignment="Left" VerticalAlignment="Top"
                      Command="{Binding CheckGridDataCommand}"/>
            </StackPanel>
          </Grid>
        </DockPanel>
      </Grid>
    </DockPanel>
    <local:WizardPageErrorsControl x:Name="PageErrorsBlock" Grid.Row="2" Grid.Column="0" Margin="0,8,0,0"/>
  </Grid>
</UserControl>