<UserControl x:Class="Intermech.Tools.Client.CompositionCopying.Views.SelectDocumentsView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Intermech.Tools.Client.CompositionCopying.Views"
             xmlns:bcl="http://schemas.intermech.org/bcl/wpf"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <bcl:SharedResourceDictionary CachedSource="CompositionCopyingCommonResources.xaml" InDesignMode="{bcl:InDesignMode}"/>
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="gridColumnsStyle" TargetType="{x:Type telerik:GridViewCell}">
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type telerik:GridViewCell}">
              <Grid>
                <ContentPresenter ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}"
                                  Content="{TemplateBinding ContentControl.Content}"
                                  HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}"
                                  Margin="{TemplateBinding Control.Padding}"
                                  VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}"/>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>
    <DockPanel Grid.Row="0" Grid.Column="0">
      <TextBlock DockPanel.Dock="Top" Margin="0,4,0,8" TextWrapping="Wrap">
        Отметьте флажками документы, которые должны быть скопированы. Неотмеченные документы будут заимствованы. Также некоторые документы будут выбраны для копирования автоматически, чтобы обеспечить корректность структуры документа. Такие документы будут отмечены знаком предупреждения
      </TextBlock>
      <StackPanel DockPanel.Dock="Top" Margin="-4,0,0,0" Orientation="Horizontal">
        <Button Content="Выбрать все" HorizontalAlignment="Left" VerticalAlignment="Top"
                Command="{Binding SelectAllNodes}"/>
        <Button Content="Отменить все" HorizontalAlignment="Left" VerticalAlignment="Top"
                Command="{Binding DeselectAllNodes}"/>
      </StackPanel>
      <telerik:RadTreeListView x:Name="DocumentTreeBlock" VerticalAlignment="Stretch" AutoGenerateColumns="false"
                               GroupRenderMode="Flat" telerik:StyleManager.Theme="Office2016" CanUserFreezeColumns="false"
                               CanUserSortColumns="false" CanUserDeleteRows="false" CanUserInsertRows="false"
                               RowIndicatorVisibility="Collapsed" ColumnWidth="*" HorizontalGridLinesBrush="Transparent"
                               ItemsSource="{Binding Nodes}" IsExpandedBinding="{Binding IsExpanded, Mode=TwoWay}">
        <FrameworkElement.Resources>
          <bcl:BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
          <bcl:ValuePresenceToVisibilityConverter x:Key="PresenceToVisibility"/>
        </FrameworkElement.Resources>
        <telerik:RadContextMenu.ContextMenu>
          <telerik:RadContextMenu ItemContainerStyle="{StaticResource RadMenuItemStyle}" telerik:StyleManager.Theme="Windows8"
                                  ItemsSource="{Binding ContextMenu.Items}"
                                  Visibility="{Binding ContextMenu.HasItems, Converter={StaticResource BooleanToVisibility}}">
            <telerik:EventToCommandBehavior.EventBindings>
              <telerik:EventBinding PassEventArgsToCommand="true" EventName="Opened" Command="{Binding ContextMenuOpenedCommand}"/>
            </telerik:EventToCommandBehavior.EventBindings>
          </telerik:RadContextMenu>
        </telerik:RadContextMenu.ContextMenu>
        <telerik:GridViewDataControl.ChildTableDefinitions>
          <telerik:TreeListViewTableDefinition ItemsSource="{Binding Nodes}"/>
        </telerik:GridViewDataControl.ChildTableDefinitions>
        <telerik:GridViewDataControl.Columns>
          <telerik:GridViewDataColumn Header="Имя объекта" MinWidth="250" IsReadOnly="true" CellStyle="{StaticResource gridColumnsStyle}">
            <telerik:GridViewColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Height="16" Margin="0,2">
                  <CheckBox Margin="2,0" IsChecked="{Binding CopyingSelector.IsSelected}"
                            IsEnabled="{Binding CopyingSelector.IsUserEditable}"
                            Visibility="{Binding CopyingSelector, Converter={StaticResource PresenceToVisibility}, FallbackValue=Collapsed}"/>
                  <Image Margin="2,0" Source="{x:Static local:CompositionCopyingImages.Warning}"
                         ToolTip="{Binding CopyingSelector.Hint, Mode=OneWay}"
                         Visibility="{Binding CopyingSelector.HasHint, Converter={StaticResource BooleanToVisibility}, FallbackValue=Collapsed}"/>
                  <TextBlock Margin="2,0" Text="{Binding Caption}"/>
                </StackPanel>
              </DataTemplate>
            </telerik:GridViewColumn.CellTemplate>
          </telerik:GridViewDataColumn>
        </telerik:GridViewDataControl.Columns>
      </telerik:RadTreeListView>
    </DockPanel>
    <local:WizardPageErrorsControl x:Name="PageErrorsBlock" Grid.Row="1" Grid.Column="0" Margin="0,8,0,0"/>
  </Grid>
</UserControl>