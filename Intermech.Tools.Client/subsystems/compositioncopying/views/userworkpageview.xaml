<UserControl x:Class="Intermech.Tools.Client.CompositionCopying.Views.UserWorkPageView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Intermech.Tools.Client.CompositionCopying.Views"
             xmlns:bcl="http://schemas.intermech.org/bcl/wpf">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <bcl:SharedResourceDictionary CachedSource="CompositionCopyingCommonResources.xaml" InDesignMode="{bcl:InDesignMode}"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <FrameworkElement.Resources>
      <bcl:BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
    </FrameworkElement.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Grid.Column="0">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
        <Image Height="20" Width="20" Margin="0,0,3,0">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type Image}">
              <Setter Property="Image.Source" Value="{x:Static local:CompositionCopyingImages.Warning}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding UserWorkItems.Count}" Value="0">
                  <Setter Property="Image.Source" Value="{x:Static local:CompositionCopyingImages.Completed}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </Image>
        <TextBlock Margin="4" TextWrapping="Wrap" Text="{Binding PageDescription}"/>
      </StackPanel>
      <ListBox Margin="4" MinHeight="100" VerticalAlignment="Stretch" ItemsSource="{Binding UserWorkItems}"
               Visibility="{Binding VisibleSaveButton, Converter={StaticResource BooleanToVisibility}}"/>
    </DockPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="1">
      <Button Content="Сохранить отчёт" HorizontalAlignment="Left" VerticalAlignment="Top"
              Command="{Binding SaveToHtmlCommand}"
              Visibility="{Binding VisibleSaveButton, Converter={StaticResource BooleanToVisibility}}"
              IsEnabled="{Binding EnableSaveButton}"/>
    </StackPanel>
  </Grid>
</UserControl>