<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:bcl="http://schemas.intermech.org/bcl/wpf"
                    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation">
  <bcl:BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
  <bcl:ValuePresenceToVisibilityConverter x:Key="PresenceToVisibility"/>
  <Style TargetType="{x:Type Button}">
    <Setter Property="FrameworkElement.Margin" Value="4"/>
    <Setter Property="Control.Padding" Value="16, 2"/>
    <Setter Property="FrameworkElement.MinWidth" Value="95"/>
    <Setter Property="FrameworkElement.MinHeight" Value="25"/>
  </Style>
  <Style x:Key="TreeViewSelectedItemAsParameter" TargetType="{x:Type MenuItem}">
    <Setter Property="MenuItem.CommandParameter"
            Value="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ContextMenu}}}"/>
  </Style>
  <Style x:Key="RadMenuItemStyle" TargetType="{x:Type telerik:RadMenuItem}">
    <Setter Property="telerik:RadMenuItem.CommandParameter"
            Value="{Binding PlacementTargetInternal.SelectedItem, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type telerik:RadContextMenu}}}"/>
  </Style>
</ResourceDictionary>