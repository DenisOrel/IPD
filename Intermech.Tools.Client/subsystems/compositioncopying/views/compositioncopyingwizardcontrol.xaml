<UserControl x:Class="Intermech.Tools.Client.CompositionCopying.Views.CompositionCopyingWizardControl" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Intermech.Tools.Client.CompositionCopying.Views"
             xmlns:bcl="http://schemas.intermech.org/bcl/wpf"
             SnapsToDevicePixels="true">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <bcl:SharedResourceDictionary CachedSource="CompositionCopyingCommonResources.xaml" InDesignMode="{bcl:InDesignMode}"/>
      </ResourceDictionary.MergedDictionaries>
      <DataTemplate DataType="{x:Type local:SelectDocumentsPageVM}">
        <local:SelectDocumentsView/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type local:PrescanDocumentsPageVM}">
        <local:PrescanDocumentsPageView/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type local:AttributesEditPageVM}">
        <local:AttributesEditPageView/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type local:CopyFilesPageVM}">
        <local:CopyFilesPageView/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type local:CopyDocumentsPageVM}">
        <local:CopyDocumentsPageView/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type local:UserWorkPageVM}">
        <local:UserWorkPageView/>
      </DataTemplate>
      <Style x:Key="FinishCancelButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Style.Triggers>
          <DataTrigger Binding="{Binding FinishCommand.Enabled}" Value="True">
            <Setter Property="ContentControl.Content" Value="Готово"/>
            <Setter Property="ButtonBase.Command" Value="{Binding FinishCommand}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding FinishCommand.Enabled}" Value="False">
            <Setter Property="ContentControl.Content" Value="Отмена"/>
            <Setter Property="ButtonBase.Command" Value="{Binding CancelCommand}"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="1" Grid.Column="0" Margin="4,4" Orientation="Horizontal">
      <TextBlock FontSize="18" FontWeight="Bold" Padding="0,8" VerticalAlignment="Center"
                 Text="{Binding CurrentPage.DisplayName}"/>
    </StackPanel>
    <ContentControl Grid.Row="2" Grid.Column="0" Margin="4,4" Content="{Binding Path=CurrentPage}"/>
    <DockPanel Grid.Row="3" Grid.Column="0" LastChildFill="false" Margin="0,4">
      <Button DockPanel.Dock="Right" Style="{StaticResource FinishCancelButton}"/>
      <Button DockPanel.Dock="Right" Content="Вперед&gt;" Command="{Binding NextPageCommand}"/>
      <Button DockPanel.Dock="Right" Content="&lt;Назад" Command="{Binding PreviousPageCommand}"/>
    </DockPanel>
  </Grid>
</UserControl>