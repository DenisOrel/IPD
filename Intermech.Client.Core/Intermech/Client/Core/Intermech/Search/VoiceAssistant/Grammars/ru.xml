  <!-- Подтверждение -->

  <rule id="Close" scope="public">
    <tag>out="Close";</tag>
    <one-of>
      <item>закрыть</item>
      <item>закройся</item>
    </one-of>
  </rule>
  <rule id ="OK" scope="public">
    <tag>out="OK";</tag>
    <one-of>
      <item>ок</item>
      <item>окей</item>
      <item>применить</item>
    </one-of>
  </rule>
  <rule id="Cancel" scope="public">
    <tag>out="Cancel";</tag>
    <one-of>
      <item>отменить</item>
      <item>отмена</item>
    </one-of>
  </rule>
  <rule id="Yes" scope="public">
    <tag>out="Yes";</tag>
    <one-of>
      <item>да</item>
      <item>ага</item>
      <item>ыгы</item>
    </one-of>
  </rule>
  <rule id="No" scope="public">
    <tag>out="No";</tag>
    <one-of>
      <item>нет</item>
      <item>не</item>
    </one-of>
  </rule>
  <rule id="Abort" scope="public">
    <tag>out="Abort";</tag>
    <one-of>
      <item>прервать</item>
    </one-of>
  </rule>
  <rule id="Retry" scope="public">
    <tag>out="Retry";</tag>
    <one-of>
      <item>повторить</item>
      <item>еще раз</item>
    </one-of>
  </rule>
  <rule id="Ignore" scope="public">
    <tag>out="Ignore";</tag>
    <one-of>
      <item>пропустить</item>
      <item>игнорировать</item>
    </one-of>
  </rule>
  <rule id="Confirmation" scope="public">
    <one-of>
      <item>
        <ruleref uri="#Close" />
      </item>
      <item>
        <ruleref uri="#OK" />
      </item>
      <item>
        <ruleref uri="#Cancel" />
      </item>
      <item>
        <ruleref uri="#Yes" />
      </item>
      <item>
        <ruleref uri="#No" />
      </item>
      <item>
        <ruleref uri="#Abort" />
      </item>
      <item>
        <ruleref uri="#Retry" />
      </item>
      <item>
        <ruleref uri="#Ignore" />
      </item>

    </one-of>
  </rule>

